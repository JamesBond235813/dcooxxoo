diff --git a/static/checkout/official/assets/js/checkout.js b/static/checkout/official/assets/js/checkout.js
index 7956521..d0ce6f4 100644
--- a/static/checkout/official/assets/js/checkout.js
+++ b/static/checkout/official/assets/js/checkout.js
@@ -679,6 +679,32 @@
         document.getElementById('orderFiatQ').textContent = d.fiat || '';
         document.getElementById('payAmountQ').textContent = amount + ' ' + currency;
         document.getElementById('payNetworkQ').textContent = _t('networkPrefix', '区块网络 · ') + netName;
+        var networkWarning = document.getElementById('networkWarningQ');
+        var networkIdentity = (String(netName || '') + ' ' + String(network || '')).toUpperCase();
+        if (networkWarning && String(currency || '').toUpperCase() === 'USDT') {
+            var networkLabel = '';
+            var networkInstruction = '';
+            if (/TRC20|TRON/.test(networkIdentity)) {
+                networkLabel = 'TRON（TRC20）';
+                networkInstruction = '请只使用 TRON / TRC20 网络转账。';
+            } else if (/BEP20|BSC|BEP-20/.test(networkIdentity)) {
+                networkLabel = 'BNB Smart Chain（BEP20）';
+                networkInstruction = '请只使用 BNB Smart Chain / BEP20 网络转账。';
+            } else if (/ERC20|ETHEREUM|ETH/.test(networkIdentity)) {
+                networkLabel = 'Ethereum（ERC20）';
+                networkInstruction = '请只使用 Ethereum / ERC20 网络转账。';
+            }
+            if (networkLabel) {
+                networkWarning.innerHTML = '<strong>本单仅接收 ' + networkLabel + ' 网络 USDT</strong>' + networkInstruction + ' 发送到其他网络可能造成资产损失。';
+                networkWarning.style.display = 'block';
+            } else {
+                networkWarning.textContent = '请先核对所选区块链网络，再发送 USDT；网络不一致可能造成资产损失。';
+                networkWarning.style.display = 'block';
+            }
+        } else if (networkWarning) {
+            networkWarning.style.display = 'none';
+            networkWarning.textContent = '';
+        }
         document.getElementById('orderIdQ').textContent = d.order_id || '--';
         var paymentAddress = d.token || d.address || '';
         renderWalletAddress(paymentAddress);
